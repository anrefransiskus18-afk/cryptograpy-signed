# Template Environment PRODUCTION
# Salin menjadi `.env.production` (jangan pernah di-commit ke Git/GitLab) lalu isi nilainya.
APP_ENV=production
TRUST_PROXY=true

# Port Docker Compose untuk Production
MYSQL_PORT=3306
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Acak minimal 32 karakter: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
SEED_DEFAULT_PASSWORD=
SEED_KEY_PASSPHRASE=

# Origin Production (WAJIB domain spesifik, DILARANG '*' di production)
CORS_ORIGINS=https://cryptograpy-signed.anrefransiskus18.workers.dev,https://docshield.ptxyz.co.id
COOKIE_SAMESITE=None

# Frontend Build Args
VITE_API_BASE_URL=/api/v1
VITE_SHOW_DEMO_ACCOUNTS=false

# Monitoring (Prometheus & Grafana)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=
