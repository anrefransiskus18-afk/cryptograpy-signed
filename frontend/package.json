{
  "name": "hybrid-crypto-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "test": "node --import ./tests/register-loader.mjs --test tests/*.test.js",
    "test:coverage": "node --import ./tests/register-loader.mjs --test --experimental-test-coverage --test-coverage-exclude='tests/**' tests/*.test.js",
    "test:integration": "node --import ./tests/register-loader.mjs --test tests/integration.test.js",
    "lint:arch": "node scripts/check-architecture.mjs",
    "check": "npm run lint:arch && npm test && npm run build"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "pinia": "^4.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  }
}
