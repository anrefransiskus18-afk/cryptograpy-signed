# Template Environment STAGING
# Salin menjadi `.env.staging` (jangan pernah di-commit ke Git/GitLab) lalu isi nilainya.
APP_ENV=staging
TRUST_PROXY=true

# Port Docker Compose untuk Staging (berbeda dari Production agar bisa jalan berdampingan)
MYSQL_PORT=3307
BACKEND_PORT=8001
FRONTEND_PORT=5174

# Database MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Acak minimal 32 karakter: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
SEED_DEFAULT_PASSWORD=
SEED_KEY_PASSPHRASE=

# Origin Staging (pisahkan koma jika lebih dari satu)
CORS_ORIGINS=https://staging.docshield.ptxyz.local,http://localhost:5174

# Frontend Build Args
VITE_API_BASE_URL=/api/v1
VITE_SHOW_DEMO_ACCOUNTS=false
