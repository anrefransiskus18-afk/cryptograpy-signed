# Variabel untuk docker-compose.yml. Salin menjadi `.env` (jangan di-commit) lalu isi semua nilainya.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Acak, minimal 32 karakter: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
SEED_DEFAULT_PASSWORD=
SEED_KEY_PASSPHRASE=
CORS_ORIGINS=http://localhost:5173
APP_ENV=production
