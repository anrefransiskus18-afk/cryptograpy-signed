# Konfigurasi Environment Backend PT XYZ Hybrid Cryptography Framework
# Salin berkas ini menjadi `.env` lalu isi nilainya. JANGAN commit berkas `.env`.

# Mode aplikasi: development | production
# Pada production, server MENOLAK start bila rahasia di bawah masih memakai nilai bawaan.
APP_ENV=development
APP_NAME="PT XYZ Internal Information Security Framework (AES-256-GCM & ECC P-256)"

# Rahasia penandatangan JWT (acak, minimal 32 karakter). Contoh membuat:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=120

# Koneksi Database MySQL 8.0 (wajib diisi pada production)
DATABASE_URL="mysql+pymysql://ptxyz_user:GANTI_PASSWORD_DB@127.0.0.1:3306/hybrid_crypto_db?charset=utf8mb4"

# Data awal (seed) akun demo. Wajib diganti pada production.
SEED_DEFAULT_PASSWORD=
SEED_KEY_PASSPHRASE=

# Penguncian akun setelah gagal login berulang
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Konfigurasi Kriptografi & Upload
DEFAULT_KEY_WRAP_MODE="XOR_AAD"
MAX_CONTENT_LENGTH=131072000

# Origin frontend yang diizinkan (pisahkan koma). Jangan memakai "*" pada production.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60
